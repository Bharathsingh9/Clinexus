# ==========================================
# Clinexus Environment Configuration Template
# SPEC Section 2, Section 8, Section 13
# Note: Placeholders only. Never commit secrets.
# ==========================================

# Project
PROJECT_NAME="Clinexus"
ENVIRONMENT="development"

# PostgreSQL 16 Persistence
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/clinexus"
DATABASE_SYNC_URL="postgresql+psycopg2://postgres:postgres_password@localhost:5432/clinexus"

# Qdrant Vector Storage
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_VERSION=1

# Embedding Model (SPEC App A6, DEC-012)
# Authoritative default: pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb
# Documented fallback only: NeuML/pubmedbert-base-embeddings
EMBEDDING_MODEL="pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb"
EMBED_BATCH_SIZE=32

# LLM Provider & Per-Agent Models (SPEC App A7, Section 13)
# Provider options: fake | openai | anthropic | gemini
LLM_PROVIDER="fake"
LLM_API_KEY="your-llm-provider-api-key-here"
LLM_MODEL="your-default-llm-model-name"
LLM_MODEL_CLARIFIER=""
LLM_MODEL_RAG=""
LLM_MODEL_SCANNER=""
LLM_MODEL_FUSION=""
LLM_MODEL_OPTIMIZER=""
VERIFIER_MODEL=""

# NCBI E-utilities (Optional; provides 10 req/s instead of 3 req/s)
NCBI_EMAIL="your-email@example.com"
NCBI_API_KEY="your-ncbi-api-key-here"

# Algorithmic & Workflow Defaults (SPEC Section 2)
MAX_OPTIMIZER_ITERATIONS=3
CONFIDENCE_THRESHOLD=0.65
RETRIEVAL_TOP_K=10
RETRIEVAL_MIN_SCORE=0.30
CHUNK_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
EXTERNAL_MAX_RECORDS_PER_QUERY=10
HTTP_TIMEOUT_S=15
HTTP_MAX_RETRIES=3
MIN_RELEVANT_PASSAGES=2
STALE_YEARS=10
EXTERNAL_MODE="online"

# Auth & Admin Credentials (SPEC Section 2, Section 7)
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL="admin@clinexus.local"
ADMIN_PASSWORD="replace-with-a-secure-admin-password"
